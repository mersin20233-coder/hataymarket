rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mersin20233@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*')) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection for role checking
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users Collection (Profile, addresses, favorites per user)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Products Collection (Public read for catalogue, write permitted to authenticated users/merchants/admins)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Stores Collection (Public read, write by admin/verified)
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn() && isAdmin();
    }

    // Orders Collection (Customer, Courier, Merchant and Admin tracking)
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Audit Logs (System actions and security traceability)
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable logs
    }

    // Price Alerts Collection (Akıllı Fiyat Alarmları)
    match /priceAlerts/{alertId} {
      allow read, write: if isSignedIn();
    }

    // Categories Collection (Public read for app, write by authorized users)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Stock Movement History Logs (Immutable audit tracking)
    match /stockMovementLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
